+  FaXTwitter,
+  FaYoutube,
+} from "react-icons/fa6";
+import { SiKick, SiSubstack } from "react-icons/si";
+
+// Exact labels are the persisted contract; custom labels are never normalized.
+export const linkPlatforms = [
+  { label: "Behance", Icon: FaBehance },
+  { label: "Bluesky", Icon: FaBluesky },
+  { label: "Discord", Icon: FaDiscord },
+  { label: "Dribbble", Icon: FaDribbble },
+  { label: "Facebook", Icon: FaFacebook },
+  { label: "GitHub", Icon: FaGithub },
+  { label: "Instagram", Icon: FaInstagram },
+  { label: "Kick", Icon: SiKick },
+  { label: "LINE", Icon: FaLine },
+  { label: "LinkedIn", Icon: FaLinkedin },
+  { label: "Mastodon", Icon: FaMastodon },
+  { label: "Medium", Icon: FaMedium },
+  { label: "Messenger", Icon: FaFacebookMessenger },
+  { label: "Patreon", Icon: FaPatreon },
+  { label: "Pinterest", Icon: FaPinterest },
+  { label: "Reddit", Icon: FaReddit },
+  { label: "Signal", Icon: FaSignalMessenger },
+  { label: "Snapchat", Icon: FaSnapchat },
+  { label: "SoundCloud", Icon: FaSoundcloud },
+  { label: "Spotify", Icon: FaSpotify },
+  { label: "Substack", Icon: SiSubstack },
+  { label: "Telegram", Icon: FaTelegram },
+  { label: "Threads", Icon: FaThreads },
+  { label: "TikTok", Icon: FaTiktok },
+  { label: "Tumblr", Icon: FaTumblr },
+  { label: "Twitch", Icon: FaTwitch },
+  { label: "Vimeo", Icon: FaVimeo },
+  { label: "WhatsApp", Icon: FaWhatsapp },
+  { label: "X", Icon: FaXTwitter },
+  { label: "YouTube", Icon: FaYoutube },
+] as const;
+
+export function linkPlatform(label: string) {
+  return linkPlatforms.find((platform) => platform.label === label);
+}
+
+export function LinkIcon({ label }: { label: string }) {
+  const Icon = linkPlatform(label)?.Icon ?? FaLink;
+  return (
+    <Icon
+      className="link-icon"
+      size={22}
+      aria-hidden="true"
+      focusable="false"
+    />
+  );
+}
