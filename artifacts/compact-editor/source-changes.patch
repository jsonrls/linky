@@ -0,0 +1,163 @@
+.editor-shell .editor-header {
+  padding-block: 12px;
+  gap: 12px;
+}
+.editor-shell .publication-strip {
+  padding-block: 12px;
+  gap: 12px;
+}
+.editor-shell .publication-strip p + p {
+  margin-top: 4px;
+}
+.editor-shell .mobile-view-tabs {
+  padding-top: 12px;
+}
+.editor-shell .edit-pane {
+  padding-top: 12px;
+  container: editor / inline-size;
+  --content-toolbar-height: 68px;
+}
+.editor-shell .tabs button {
+  padding-block: 10px;
+}
+.editor-shell .content-toolbar {
+  position: sticky;
+  top: 0;
+  z-index: 2;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px 12px;
+  padding: 12px 16px;
+  background: var(--canvas);
+  border-bottom: 1px solid var(--divider);
+}
+.editor-shell .content-toolbar h1 {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  font-size: 1rem;
+  font-weight: 600;
+  letter-spacing: normal;
+}
+.editor-shell .content-toolbar .field-error {
+  flex-basis: 100%;
+}
+.editor-shell .edit-section {
+  padding: 16px;
+}
+.editor-shell .identity-section {
+  padding-bottom: 0;
+}
+.editor-shell .identity-disclosure,
+.editor-shell .block {
+  border: 1px solid var(--divider);
+  border-radius: 12px;
+  background: var(--raised);
+}
+.editor-shell .identity-disclosure > summary,
+.editor-shell .block > summary {
+  display: flex;
+  align-items: center;
+  flex-wrap: nowrap;
+  gap: 12px;
+  min-height: 56px;
+  padding: 12px;
+  cursor: pointer;
+  list-style: none;
+}
+.editor-shell summary::-webkit-details-marker {
+  display: none;
+}
+.editor-shell .identity-disclosure > summary::after,
+.editor-shell .block > summary::after {
+  content: "+";
+  flex: none;
+  margin-left: auto;
+  font-size: 1.25rem;
+}
+.editor-shell .identity-disclosure[open] > summary::after,
+.editor-shell .block[open] > summary::after {
+  content: "−";
+}
+.editor-shell .identity-disclosure > summary > span {
+  color: var(--secondary);
+  font-size: 0.875rem;
+}
+.editor-shell .identity-disclosure > summary > strong,
+.editor-shell .block > summary > strong {
+  flex: 1;
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+.editor-shell .block-type {
+  flex: none;
+}
+.editor-shell .identity-body,
+.editor-shell .block-body {
+  padding: 12px;
+  border-top: 1px solid var(--divider);
+}
+.editor-shell .identity-body {
+  display: grid;
+  gap: 12px;
+}
+.editor-shell .identity-body textarea {
+  min-height: 0;
+}
+.editor-shell .edit-pane .field {
+  gap: 6px;
+  margin-top: 0;
+}
+.editor-shell .edit-pane input,
+.editor-shell .edit-pane select,
+.editor-shell .edit-pane textarea {
+  font-size: 16px;
+}
+.editor-shell .edit-pane input,
+.editor-shell .edit-pane select,
+.editor-shell .edit-pane textarea,
+.editor-shell .edit-pane summary {
+  scroll-margin-block: calc(var(--content-toolbar-height) + 12px) 12px;
+}
+.editor-shell .link-fields {
+  display: grid;
+  gap: 12px;
+  align-items: start;
+}
+.editor-shell .custom-link-label {
+  grid-column: 1 / -1;
+  min-width: 0;
+}
+.editor-shell .block-list {
+  display: grid;
+  gap: 12px;
+}
+.editor-shell .block {
+  margin-top: 0;
+}
+.editor-shell .block-actions {
+  margin-top: 12px;
+}
+.editor-shell .block-actions button {
+  min-height: 44px;
+}
+.editor-shell .section-heading {
+  margin-bottom: 12px;
+}
+.editor-shell .appearance-group,
+.editor-shell .settings-section {
+  margin-top: 16px;
+}
+.editor-shell .choice-list {
+  margin-top: 12px;
+}
+.editor-shell .edit-section > .field + .field {
+  margin-top: 12px;
+}
+@container editor (min-width: 560px) {
+  .editor-shell .link-fields {
+    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
+  }
+}
